[
  {
    "id": "script_1754293443012_m4qi4jnv5",
    "title": "Galaxy's Reflection: The Eternal Gamma Love",
    "rounds": 3,
    "background": "In the year 2347, interstellar travel has become commonplace. However, a secret experiment is quietly underway in the Gamma Galaxy—time travel. Dr. Elise Carter, a brilliant physicist, is dedicated to finding a bridge between the past and the future, hoping to rectify a historical regret from a century ago. Her lover, interstellar explorer Alexander Reynolds, disappeared in an accidental spacetime jump. Elise firmly believes he is still alive and resolutely activates the forbidden time machine, 'Chronos.' However, the temporal turbulence is far more dangerous than she imagined. The era she finally arrives in is not the one where she expected to find Alexander, but another era full of mysteries...",
    "characters": [
      {
        "id": "elise_carter",
        "name": "Elise Carter",
        "identity": "Physicist from 2347",
        "personality": "Determined, persistent, intelligent, emotionally delicate",
        "isMainCharacter": true
      },
      {
        "id": "alexander_reynolds",
        "name": "Alexander Reynolds",
        "identity": "Interstellar explorer from 2347",
        "personality": "Brave, adventurous, optimistic, deeply in love with Elise",
        "isMainCharacter": true
      },
      {
        "id": "professor_meier",
        "name": "Professor Meier",
        "identity": "Chronos Project Supervisor (AI NPC)",
        "personality": "Rigorous, rational, conservative, skeptical of time travel",
        "isMainCharacter": false
      },
      {
        "id": "temporal_guardian_ara",
        "name": "Ara (Temporal Guardian)",
        "identity": "Mysterious being from an unknown era (AI NPC)",
        "personality": "Calm, mysterious, powerful, guardian of the temporal order",
        "isMainCharacter": false
      }
    ],
    "roundContents": [
      {
        "round": 1,
        "plot": "Elise arrives in Shanghai in 1923. She finds herself on an exotic pier. A mysterious man whispers in her ear: 'Seek the reflection of the Gamma star, it will guide you.' She discovers her time machine is severely damaged and cannot be started immediately. There is no news of Alexander, only a blurry photograph.",
        "privateClues": {
          "elise_carter": "The back of the photograph in your hand reads 'Eternity Cafe.' The cafe's owner seems to know some secrets about time travel. You discover that your energy core has only 30% of its power left.",
          "alexander_reynolds": "You find yourself trapped in a strange era. You are seriously injured, and your only clue is a pocket watch engraved with 'Elise.' Someone is hunting you, calling you a 'time paradox.'"
        }
      },
      {
        "round": 2,
        "plot": "Elise finds the Eternity Cafe, where the owner is an elegant woman named Song Mei. Song Mei tells her that Alexander had also been there and left a letter. The letter mentions that the 'reflection of the Gamma star' actually refers to a special observation point at the Shanghai Observatory. Meanwhile, the temporal guardian Ara warns Elise that her actions are disrupting the timeline.",
        "privateClues": {
          "elise_carter": "Song Mei shows you a star chart left by Alexander, which marks a special coordinate point. You suspect that this coordinate point is the location of Alexander's last jump. You discover a crude time research laboratory in the cafe's basement.",
          "alexander_reynolds": "You find a mysterious doctor who treats your injuries and tells you that the people hunting you are from an organization called the 'Time Management Bureau,' whose purpose is to maintain the stability of the timeline. The doctor gives you an address, saying it's a safe house."
        }
      },
      {
        "round": 3,
        "plot": "Elise goes to the Shanghai Observatory. At the observation point, she discovers a hidden energy channel that can briefly connect to the future. At the same time, Alexander also arrives at the observatory and reunites with Elise. However, agents from the Time Management Bureau have also tracked them down and are trying to stop them. The temporal guardian Ara decides to intervene, offering a final choice: repair the timeline, or travel together to an unknown future.",
        "privateClues": {
          "elise_carter": "The energy channel requires a large amount of energy to activate. You must make a choice: use the remaining energy to return to the future, or use it to find the spacetime point where Alexander fell. Alexander tells you that the Time Management Bureau's goal is to erase all possibilities of time travel.",
          "alexander_reynolds": "You notice that one of the Time Management Bureau agents looks very much like Professor Meier from the past. He tells you that Elise's actions have seriously threatened the temporal stability of the entire universe and you must stop her. Ara's appearance makes you realize that time is not linear, but an interweaving of countless possibilities."
        }
      }
    ],
    "createdAt": 1754293443012,
    "createdBy": "system"
  },
  {
    "id": "script_1754293469256_51edbkfad",
    "title": "Sakura of Reincarnation",
    "rounds": 3,
    "background": "In the year 2249, Tokyo is a highly technologically advanced city. Aya, a top programmer, accidentally discovers a time travel program called 'Sakura' hidden in an old server. Curious about her grandparents' love story, Aya activates the program, but unexpectedly transports herself and her childhood friend, Kenta, a history professor, back to Kyoto in 1944. Amidst the flames of war, the two must survive in the torrent of history, find a way back to the future, and uncover the secrets hidden behind the 'Sakura' program. More importantly, they must ensure their presence does not alter history, and this journey through time will also test the bond between them.",
    "characters": [
      {
        "id": "ayane",
        "name": "Ayane",
        "identity": "Programmer from 2249",
        "personality": "Smart, independent, curious, slightly adventurous",
        "isMainCharacter": true
      },
      {
        "id": "kenta",
        "name": "Kenta",
        "identity": "History professor from 2249",
        "personality": "Calm, knowledgeable, responsible, slightly conservative",
        "isMainCharacter": true
      },
      {
        "id": "sakura",
        "name": "Sakura",
        "identity": "Geisha from 1944",
        "personality": "Gentle, considerate, understanding, hides a secret in her heart",
        "isMainCharacter": false
      },
      {
        "id": "hideki",
        "name": "Hideki",
        "identity": "Military officer from 1944",
        "personality": "Serious, cold, loyal to his duty, has special feelings for the geisha Sakura",
        "isMainCharacter": false
      }
    ],
    "roundContents": [
      {
        "round": 1,
        "plot": "Aya and Kenta suddenly appear on the streets of Kyoto in 1944, bewildered. Their futuristic clothing attracts attention. Sakura, a beautiful geisha, notices them and offers to help. Hideki, a military officer, also becomes interested in them, but more with suspicion.",
        "privateClues": {
          "ayane": "You notice your time bracelet is malfunctioning and cannot determine the specific teleportation coordinates. The battery icon is flashing, indicating that the power is about to run out. You must find a way to charge it as soon as possible.",
          "kenta": "You notice the cherry blossom hairpin worn by Sakura is almost identical to the one worn by your grandmother in your grandfather's photograph. You begin to wonder if history is repeating itself, or if this is not a coincidence at all."
        }
      },
      {
        "round": 2,
        "plot": "Sakura takes Aya and Kenta to the teahouse where she lives, providing them with temporary shelter. Aya tries to find a device that can charge her time bracelet, but the technology of 1944 is far from adequate. Hideki begins to investigate Aya and Kenta's identities, suspecting them of being spies.",
        "privateClues": {
          "ayane": "You discover a secret room in the teahouse's basement, containing some old electronic equipment, seemingly for some secret research. You have a vague feeling that this is related to the 'Sakura' program.",
          "kenta": "You overhear a conversation between Sakura and Hideki and learn that Hideki is about to be transferred to the battlefield, and Sakura seems reluctant to part with him. You recall that your grandmother never mentioned this relationship, which does not match the historical records."
        }
      },
      {
        "round": 3,
        "plot": "Aya finally finds a clue to charge her time bracelet, but it requires using the equipment in the teahouse's basement. Hideki's investigation deepens, and he begins to suspect a connection between Sakura, Aya, and Kenta. To protect Aya and Kenta, Sakura has to make a difficult choice.",
        "privateClues": {
          "ayane": "You successfully activate the equipment in the basement, and the time bracelet begins to charge. However, the device makes a loud noise, which is likely to attract Hideki's attention. You must complete the charging as soon as possible, or all your efforts will be in vain.",
          "kenta": "You find Sakura secretly destroying some letters. The content of the letters seems to be related to time travel. You realize that Sakura may know more secrets about the 'Sakura' program, but she doesn't seem to want to tell you."
        }
      }
    ],
    "createdAt": 1754293469256,
    "createdBy": "system"
  },
  {
    "id": "script_1754294815279_l158eh1ip",
    "title": "Baozi Wars: The Battle of the Old Brand",
    "rounds": 3,
    "background": "The century-old 'Dexing Baozi Shop' is famous far and wide, and its signature fresh meat buns are renowned. The old owner, Old Master Zhao, is getting on in years and has decided to hold a unique baozi-eating contest. The winner will gain the operating rights to the Dexing Baozi Shop. As soon as the news broke, baozi lovers from all over flocked to participate. However, behind the seemingly simple competition lies a contest of family feuds and business conspiracies. Is it a simple eating competition, or a power struggle with undercurrents? In the aroma of the baozi, there is a hint of something unusual...",
    "characters": [
      {
        "id": "character1",
        "name": "Zhao Xiaoman",
        "identity": "Old Master Zhao's granddaughter, grew up in the baozi shop",
        "personality": "Shrewd and capable, gentle on the outside but tough on the inside, has a strong sense of responsibility for the family business, but is dissatisfied with her grandfather's traditional business philosophy and wants to innovate.",
        "isMainCharacter": true
      },
      {
        "id": "character2",
        "name": "Li Dazhuang",
        "identity": "A famous 'big eater', his dream is to eat all the delicacies in the world",
        "personality": "Honest and simple, with an amazing appetite, cheerful, seemingly without desires, but has a love and persistence for baozi that is beyond ordinary people.",
        "isMainCharacter": true
      },
      {
        "id": "character3",
        "name": "Aunt Wang",
        "identity": "An old employee of Dexing Baozi Shop, in charge of the back kitchen",
        "personality": "Taciturn, serious in her work, loyal to Dexing Baozi Shop, but seems to know some unknown secrets.",
        "isMainCharacter": false
      },
      {
        "id": "character4",
        "name": "Boss Zhang",
        "identity": "The owner of the new 'Delicious Baozi' shop on the next street, a business competitor",
        "personality": "Shrewd and mercenary, ambitious, bent on annexing Dexing Baozi Shop, unscrupulous in his methods.",
        "isMainCharacter": false
      }
    ],
    "roundContents": [
      {
        "round": 1,
        "plot": "The competition officially begins, and the contestants are eager to start. The first round is a timed baozi-eating contest, the one who eats the most in the allotted time wins. Zhao Xiaoman has a strategy based on her knowledge of baozi making, while Li Dazhuang takes the lead with his natural appetite. Aunt Wang watches silently from the side with a complex expression. Boss Zhang looks around in the crowd, as if searching for something.",
        "privateClues": {
          "character1": "Before the competition, your grandfather, Old Master Zhao, secretly slipped you a note that said: 'Be careful of Boss Zhang, beware of the baozi filling.' It seems your grandfather is wary of Boss Zhang.",
          "character2": "You accidentally overhear Aunt Wang muttering: 'The old master is too impulsive this time, this baozi shop is going to be in trouble sooner or later.' Aunt Wang doesn't seem to approve of the competition."
        }
      },
      {
        "round": 2,
        "plot": "The second round is a blind-tasting of fillings. Contestants need to be blindfolded and identify the baozi fillings by taste. The one who answers the most correctly wins. Zhao Xiaoman performs well due to her familiarity with the fillings since childhood. Although Li Dazhuang has a sensitive palate, he has difficulty with some special fillings. Boss Zhang starts to deliberately create chaos during the competition to interfere with the contestants' judgment.",
        "privateClues": {
          "character1": "You smell a faint medicinal taste in today's baozi filling, which is different from usual. Has someone tampered with it?",
          "character2": "You notice that Boss Zhang has been secretly observing Zhao Xiaoman, his eyes full of hostility and calculation. He seems to have other plans for Zhao Xiaoman."
        }
      },
      {
        "round": 3,
        "plot": "The final round is baozi making. Contestants need to make baozi on the spot, which will be tasted and scored by the judges. The winner is decided by the combined scores of the three rounds. Zhao Xiaoman demonstrates exquisite baozi-making skills, but finds that the flour seems to have been tampered with, affecting the taste. Although Li Dazhuang is not good at making baozi, he impresses the judges with his sincerity and love for baozi. Aunt Wang suddenly stands up and reveals a shocking truth...",
        "privateClues": {
          "character1": "You find that the baozi shop's account book is missing. This book records the business situation of Dexing Baozi Shop over the years, as well as some important business secrets.",
          "character2": "You notice a burn mark on Aunt Wang's hand, which is identical to the one you saw on Boss Zhang's hand yesterday. What is the relationship between them?"
        }
      }
    ],
    "createdAt": 1754294815279,
    "createdBy": "system"
  },
  {
    "id": "script_1754295413704_msov3ekhc",
    "title": "Old Wang's Baozi Shop",
    "rounds": 3,
    "background": "In the late Qing Dynasty and early Republic of China, under the city walls of Beiping, Old Wang opened a baozi shop that was famous far and wide. His baozi had thin skins and large fillings, and the taste was delicious, especially the secret sauce, which was addictive. However, Old Wang recently passed away, leaving behind a mysterious recipe. It is said that whoever can find this recipe can inherit Old Wang's baozi shop and his skills. The neighbors are all coveting this recipe, and undercurrents are surging. Today is the seventh day after Old Wang's death. According to custom, an altar should be set up in the baozi shop to burn paper money and worship. Everyone wants to take this opportunity to see if they can find the recipe.",
    "characters": [
      {
        "id": "character1",
        "name": "Wang Xiao'er",
        "identity": "Old Wang's son, lazy and greedy",
        "personality": "Greedy, timid, idle",
        "isMainCharacter": true
      },
      {
        "id": "character2",
        "name": "Aunt Li",
        "identity": "Old Wang's neighbor, warm-hearted",
        "personality": "Gossipy, likes to take advantage of others, outspoken"
      },
      {
        "id": "character3",
        "name": "Manager Zhang",
        "identity": "The manager of the restaurant opposite, shrewd",
        "personality": "Calculating, slick, profit-oriented"
      }
    ],
    "roundContents": [
      {
        "round": 1,
        "plot": "The seventh-day memorial service begins. Wang Xiao'er tremblingly sets up the altar, with Aunt Li and Manager Zhang helping. While burning paper money, Aunt Li mutters about how good Old Wang was. Manager Zhang looks around, as if searching for something. Wang Xiao'er seems absent-minded, his eyes glancing at the money box from time to time.",
        "privateClues": {
          "character1": "Before he died, Dad gave me a piece of paper with the word 'stove' on it. It's out of context, I don't know what it means.",
          "character2": "I saw Manager Zhang secretly rummaging through Old Wang's belongings, acting suspiciously. He must have some motive.",
          "character3": "A few days before Old Wang died, he complained to me that his son was a disappointment and he wanted to hand over the baozi shop to someone he trusted. Could the recipe be with his son?"
        }
      },
      {
        "round": 2,
        "plot": "After the memorial service, Aunt Li suggests everyone eat baozi together to commemorate Old Wang. Wang Xiao'er reluctantly agrees. Manager Zhang excuses himself to take care of his restaurant, but before leaving, he casually asks Wang Xiao'er about his future plans for the baozi shop. Aunt Li, while eating baozi, praises Old Wang's skills and indirectly asks about the recipe.",
        "privateClues": {
          "character1": "Mom said that the family heirlooms are hidden in the most unexpected places. Is there something under the stove? I have to find a chance to check.",
          "character2": "The taste of this baozi is different from before! Something is missing... right, it's missing the taste of fennel. Is fennel missing from the recipe?",
          "character3": "Wang Xiao'er's eyes are shifty, he obviously knows something. And he frequently looks towards the kitchen, there's definitely a secret there."
        }
      },
      {
        "round": 3,
        "plot": "Wang Xiao'er sneaks into the kitchen when Aunt Li is not paying attention. Aunt Li notices Wang Xiao'er's movement and quietly follows him. At this moment, Manager Zhang suddenly returns, holding a package, and also heads to the kitchen. The three of them appear in the kitchen at the same time, and the atmosphere becomes tense.",
        "privateClues": {
          "character1": "Sure enough, there's a secret compartment under the stove! Inside is a porcelain bottle with the words 'Secret Sauce' written on it. But the bottle is empty! Did someone get here first?",
          "character2": "I saw Manager Zhang holding a package of fennel! What is he trying to do? Does he want to concoct the recipe himself?",
          "character3": "Here's my chance! Wang Xiao'er found the bottle, but he seems disappointed. Now is the best time to get the recipe!"
        }
      }
    ],
    "createdAt": 1754295413704,
    "createdBy": "system"
  },
  {
    "id": "script_1754295711401_rk89l6e17",
    "title": "The Midnight Baozi Shop",
    "rounds": 3,
    "background": "Late at night, fog fills the alley. You, Master Li, are the owner of the only operating 'Old Li's Baozi Shop' on this old street. Your baozi, with their thin skin and large fillings, are famous far and wide. However, recently you've felt a strange atmosphere around you. Today is especially weird. First, old customer Aunt Zhang suddenly ordered ten meat buns, saying she was sending them to her deceased husband. Sending baozi in the middle of the night? Then, Old Man Wang, who never eats meat buns, surprisingly ordered two pork and green onion buns. Is there... a secret to these baozi? What makes you even more uneasy is that you always feel someone is watching you in the dark, watching your baozi...",
    "characters": [
      {
        "id": "character1",
        "name": "Li Laoshi",
        "identity": "Owner of Old Li's Baozi Shop",
        "personality": "Honest and dutiful, with exquisite skills, and some doubts in his heart",
        "isMainCharacter": true
      },
      {
        "id": "character2",
        "name": "Zhang Cuihua (Aunt Zhang)",
        "identity": "An old customer of Old Li's Baozi Shop",
        "personality": "Warm-hearted, a bit nagging, her recent behavior is a bit strange",
        "isMainCharacter": false
      },
      {
        "id": "character3",
        "name": "Wang Fugui (Old Man Wang)",
        "identity": "A regular customer of Old Li's Baozi Shop",
        "personality": "Solitary, taciturn, usually only eats vegetarian buns",
        "isMainCharacter": false
      }
    ],
    "roundContents": [
      {
        "round": 1,
        "plot": "Late at night, Aunt Zhang hurriedly comes to the baozi shop, buys ten meat buns, and looks flustered. Old Man Wang comes later, specifically asking for two pork and green onion buns, but takes two steamed buns and leaves, saying he's old and forgetful.",
        "privateClues": {
          "character1": "The money Aunt Zhang gave you is newly printed ghost money, with burn marks on it. After Old Man Wang leaves, you find a folded piece of paper he left on the table, which says 'See you in the back alley at midnight tonight.'",
          "character2": "You heard that Li Laoshi recently developed a new baozi filling that is said to prolong life. For your deceased husband, you want to give it a try. Li Laoshi seems to have discovered something.",
          "character3": "I shouldn't eat meat buns, but to get close to Li Laoshi, I have to. The content of the note must be delivered to him tonight."
        }
      },
      {
        "round": 2,
        "plot": "You decide to follow Old Man Wang and find that he didn't go home, but is hiding in the shadows of the back alley. Aunt Zhang also seems to be loitering nearby, looking towards your baozi shop from time to time. A low cry comes from the depths of the alley.",
        "privateClues": {
          "character1": "Old Man Wang seems to be waiting for someone. He is clutching a medicine bottle, on which the words 'prolong life' are faintly visible. Aunt Zhang seems to be hiding from someone, she keeps looking back with fear in her eyes.",
          "character2": "I must stop Old Man Wang! He's going to ruin Li Laoshi! I saw the medicine bottle he was holding, it's a forbidden drug that makes people lose their minds!",
          "character3": "Time is running out, I must tell Li Laoshi the truth. Zhang Cuihua is watching me, she knows my plan."
        }
      },
      {
        "round": 3,
        "plot": "Midnight arrives, and a dark figure suddenly appears in the back alley. Old Man Wang tremblingly hands the dark figure a baozi. The dark figure swallows the baozi in one bite and lets out a strange laugh. Aunt Zhang suddenly rushes out, shouting: 'Don't eat it!'",
        "privateClues": {
          "character1": "The identity of the dark figure is unknown, but he has a strange tattoo on the back of his hand, like a twisted baozi. Aunt Zhang rushes towards the dark figure, but is kicked away and faints.",
          "character2": "That dark figure... it's Old Chen! He ate Li Laoshi's baozi! It's over, it's all over!",
          "character3": "My mission has failed... that baozi was eaten by Old Chen. Li Laoshi, run!"
        }
      }
    ],
    "createdAt": 1754295711401,
    "createdBy": "system"
  },
  {
    "id": "script_1754296184455_m7z394qrt",
    "title": "The Mystery of the Crispy Corners",
    "rounds": 3,
    "background": "The quiet town of Clayville is famous for its unique Crispy Corners factory. The factory is the town's economic pillar, but recently it has been shrouded in shadow. The taste of the Crispy Corners produced by the factory has been declining, and there have even been strange changes in flavor. People suspect that there is a problem within the factory, that someone is secretly sabotaging it, trying to destroy the factory. Emily Carter, the quality control supervisor of the Crispy Corners factory, must find out the truth before everything is irreversible and save the future of the town.",
    "characters": [
      {
        "id": "emilyCarter",
        "name": "Emily Carter",
        "identity": "Crispy Corners Factory Quality Control Supervisor",
        "personality": "Serious and responsible, strives for perfection, has a strong sense of justice",
        "isMainCharacter": true
      },
      {
        "id": "georgeMiller",
        "name": "George Miller",
        "identity": "An old employee of the Crispy Corners factory, in charge of the production line",
        "personality": "Taciturn, experienced, somewhat mysterious",
        "isMainCharacter": false
      },
      {
        "id": "lindaBrown",
        "name": "Linda Brown",
        "identity": "A new intern at the Crispy Corners factory",
        "personality": "Lively and cheerful, curious, likes to gossip",
        "isMainCharacter": false
      }
    ],
    "roundContents": [
      {
        "round": 1,
        "plot": "Emily discovers that a recent batch of Crispy Corners used expired spices, resulting in a poor taste. The production line managed by George is the main suspect. Linda tells Emily that she saw George secretly entering the warehouse at night, acting suspiciously.",
        "privateClues": {
          "emilyCarter": "The quality control records show that the batch number of the expired spices is 20231026, and the supplier is the distant 'Old Joe's Spice Company.' George has been taking frequent leave recently, saying he has family matters.",
          "georgeMiller": "My wife has been sick recently and needs a lot of money. I had to secretly take on some private work. I went to the warehouse at night to help someone move goods, it has absolutely nothing to do with Crispy Corners. I don't know anything about the spices.",
          "lindaBrown": "George was wearing a strange black coat that night, he seemed afraid of being recognized. He was also carrying a large black bag, I don't know what was inside. Afterwards, I smelled a strong caramel scent."
        }
      },
      {
        "round": 2,
        "plot": "Emily investigates 'Old Joe's Spice Company' and finds that the company went out of business three years ago. She asks George about the expired spices, but he is evasive and refuses to answer. Linda claims she found the black coat George discarded, which contained some Crispy Corner crumbs with a strange taste.",
        "privateClues": {
          "emilyCarter": "The last person in charge of 'Old Joe's Spice Company' was named Jonathan Miller, which is only one word different from George Miller. The Crispy Corner crumbs on the black coat were tested and found to contain a small amount of cyanide.",
          "georgeMiller": "Jonathan Miller is my cousin. He used to run a spice company, but he passed away a long time ago. The coat is not mine, I've never worn that style. Someone is trying to frame me!",
          "lindaBrown": "I found in the factory's surveillance footage that a figure secretly entered the spice warehouse, but it was too dark to see who it was. The figure's build is similar to George's, but the walking posture is somewhat different."
        }
      },
      {
        "round": 3,
        "plot": "Emily discovers that the factory's ventilation system has been tampered with, and the cyanide was likely mixed into the Crispy Corners through the ventilation system. Linda admits that she was instructed by someone to deliberately frame George. The mastermind turns out to be... (the truth needs to be filled in based on the players' reasoning, here we assume the mastermind is the owner of the Crispy Corners factory, who wants to make the factory go bankrupt and then acquire other factories at a low price)",
        "privateClues": {
          "emilyCarter": "The factory owner has been secretly in contact with competitors recently, seemingly discussing acquisition matters. The owner also gave Linda a promotion and a raise, encouraging her to 'learn more experience.'",
          "georgeMiller": "The owner often says sarcastic things to me, seeming dissatisfied with my work. He always hints that I should retire early and give my position to the younger generation.",
          "lindaBrown": "The owner promised me that if I could get rid of George, he would make me the supervisor of the production line. I admit I was foolish for a moment and did something wrong, but I regret it now."
        }
      }
    ],
    "createdAt": 1754296184455,
    "createdBy": "system"
  },
  {
    "id": "script_1754296546629_awuhxq8hd",
    "title": "French Fry Championship: Who Stole My Fries?",
    "rounds": 3,
    "background": "The annual 'French Fry Championship' kicks off at the headquarters of the fast-food restaurant 'Golden Crisp.' Four contestants gather with one goal: to eat the most fries in three rounds and win the title of 'French Fry King' and a lifetime supply of free fries from 'Golden Crisp.' However, on the eve of the competition, one of the contestants, Ah Qiang, discovers that his secret weapon - a special mustard sauce - has disappeared. This mustard sauce is the key to his victory! Seeds of suspicion spread among the contestants. This competition is not just about fries, but a contest of trust and conspiracy. Who is the mastermind? And where did the mustard sauce go?",
    "characters": [
      {
        "id": "阿强",
        "name": "Li Aqiang",
        "identity": "Veteran fry lover, runner-up in previous competitions",
        "personality": "Forthright, competitive, slightly neurotic, has an almost obsessive love for fries",
        "isMainCharacter": true
      },
      {
        "id": "小美",
        "name": "Wang Xiaomei",
        "identity": "Food blogger, new internet celebrity",
        "personality": "Lively and cheerful, good at socializing, seemingly simple but actually shrewd",
        "isMainCharacter": false
      },
      {
        "id": "老王",
        "name": "Wang Laogen",
        "identity": "Retired old cadre, self-proclaimed 'fry health expert'",
        "personality": "Stubborn, conservative, likes to pull rank, has unique views on how to eat fries",
        "isMainCharacter": false
      },
      {
        "id": "艾米",
        "name": "Emily",
        "identity": "International student, curious baby",
        "personality": "Enthusiastic, curious, likes to try new things, full of interest in Asian culture",
        "isMainCharacter": false
      }
    ],
    "roundContents": [
      {
        "round": 1,
        "plot": "The competition officially begins. The host announces the rules: the first round is a 'speed challenge,' where contestants need to eat as many fries as possible in five minutes. During the competition, Ah Qiang is obviously affected, his speed is much slower than before, while the others perform normally. Xiaomei seems nonchalant, but the number of fries she eats is amazing. Old Wang still insists on his 'healthy eating method,' chewing slowly. Emily is trying various dipping sauces.",
        "privateClues": {
          "阿强": "You clearly checked that the mustard sauce was in your bag this morning, but now it's gone. You suspect Xiaomei, because she was hovering around you just now and asked you 'What secret weapon did you prepare?'.",
          "小美": "Before the competition, you saw Old Wang secretly sprinkling a strange white powder on his fries. You think this must be his secret to winning, and he is particularly unwilling to let others get close to his fries.",
          "老王": "You see Emily constantly taking pictures, as if she is recording your posture of eating fries. You think she might be studying something, which makes you feel uncomfortable.",
          "艾米": "You notice that Ah Qiang looks absent-minded and keeps staring at his bag. It seems that something is very important to him, and he seems to have lost it. You also hear him muttering 'mustard sauce' under his breath."
        }
      },
      {
        "round": 2,
        "plot": "The second round is 'creative eating.' Contestants need to use the provided ingredients to create a unique way of eating fries. Ah Qiang is still unhappy and casually puts something together. Xiaomei mixes ketchup and mustard sauce to create a new flavor, which wins praise from everyone. Old Wang dips his fries in goji berry-infused water, sparking controversy. Emily eats her fries with ice cream, saying this is the authentic 'American way.'",
        "privateClues": {
          "阿强": "You notice that the mustard sauce Xiaomei is using seems very similar to the packaging of your lost one, but you can't be sure. You also see Old Wang secretly watching you with a hint of schadenfreude in his eyes.",
          "小美": "You learn from the host that the mustard sauce was specially provided by the sponsor, and there is only one. You begin to suspect that Ah Qiang may not have brought any mustard sauce at all, and it was all a play he directed himself to disrupt your concentration.",
          "老王": "You notice that some of Emily's ice cream has melted and dripped on the floor. Some strange white powder appears on the floor, which you recognize as an ingredient of some kind of laxative. You begin to suspect that someone wants to frame others.",
          "艾米": "You accidentally see Old Wang secretly pouring some white powder into Ah Qiang's drink. You don't know what it is, but you feel that things are getting more and more complicated."
        }
      },
      {
        "round": 3,
        "plot": "The final round is the 'endurance challenge.' Contestants need to maintain their speed of eating fries as much as possible for ten minutes. Whoever lasts to the end is the winner. After eating the first bite of fries, Ah Qiang suddenly turns pale, clutches his stomach, and runs out. Xiaomei, Old Wang, and Emily continue the competition, but the atmosphere is extremely tense. In the end, Xiaomei wins the competition with her stable performance. However, after the competition, Ah Qiang claims that he was framed.",
        "privateClues": {
          "阿强": "After drinking the drink, your stomach starts to hurt badly. You are sure that someone put something in your drink. You suspect Old Wang, because he has always been resentful of your 'secret weapon.'",
          "小美": "You won the competition, but you feel that something is not right. You begin to suspect that you have been used, and the real goal is not the championship, but something else.",
          "老王": "You see Emily secretly wiping the white powder off the floor after Ah Qiang left. You begin to suspect that Emily is the mastermind, and she may be using this competition to conduct some secret transaction.",
          "艾米": "You see Xiaomei secretly stuffing something into her bag after the competition. You think she must know something, and she is very likely the one who stole Ah Qiang's mustard sauce."
        }
      }
    ],
    "createdAt": 1754296546629,
    "createdBy": "system"
  },
