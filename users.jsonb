    "gameHistory": [],
    "collectedScripts": [
      {
        "id": "collected_1754295505022_dl7ehr0cq",
        "originalScriptId": "script_1754295413704_msov3ekhc",
        "originalGameId": "game_1754295438744_j9vbr7qc2",
        "title": "老王的包子铺",
        "rounds": 3,
        "background": "清末民初，北平城根儿下，老王开了家包子铺，远近闻名。他家的包子皮薄馅大，味道鲜美，尤其是秘制酱料，更是让人百吃不厌。然而，最近老王去世了，留下了一张神秘的配方。据说，谁能找到这张配方，就能继承老王的包子铺和他的手艺。街坊邻居都觊觎着这份配方，暗流涌动。今天是老王头七，按照习俗，要在包子铺里摆上供桌，烧纸祭拜。大家都想借着这个机会，看看有没有机会找到配方。",
        "characters": [
          {
            "id": "character1",
            "name": "王小二",
            "identity": "老王的儿子，好吃懒做",
            "personality": "贪财，胆小，游手好闲",
            "isMainCharacter": true
          },
          {
            "id": "character2",
            "name": "李婶",
            "identity": "老王的邻居，热心肠",
            "personality": "八卦，爱占便宜，心直口快"
          },
          {
            "id": "character3",
            "name": "张掌柜",
            "identity": "对面酒楼的掌柜，精明",
            "personality": "算计，圆滑，唯利是图"
          }
        ],
        "roundContents": [
          {
            "round": 1,
            "plot": "头七祭拜开始了，王小二颤颤巍巍地摆上供桌，李婶和张掌柜也在一旁帮忙。李婶一边烧纸，一边嘀咕着老王的好。张掌柜则四处张望，似乎在寻找什么。王小二显得心不在焉，眼睛时不时地瞟向钱匣子。",
            "privateClues": {
              "character1": "爹临走前，塞给我一个写着“灶”字的纸条，没头没尾的，不知道啥意思。",
              "character2": "我看到张掌柜偷偷摸摸地翻动着老王的遗物，鬼鬼祟祟的。他肯定有什么目的。",
              "character3": "老王去世前几天，曾跟我抱怨，说他儿子不争气，想把包子铺交给信任的人。难道配方在他儿子手里？"
            }
          },
          {
            "round": 2,
            "plot": "祭拜结束后，李婶提议大家一起吃包子，缅怀老王。王小二勉强同意。张掌柜借口要照顾酒楼生意，先行离开，但临走前，他状似无意地问了王小二关于包子铺未来的打算。李婶则一边吃着包子，一边夸赞老王的手艺，并旁敲侧击地询问配方的事情。",
            "privateClues": {
              "character1": "娘说过，家里的传家宝都藏在最意想不到的地方。灶台下面有什么东西吗？得找机会去看看。",
              "character2": "这包子的味道跟以前不一样了！少了点什么…对了，是少了点茴香的味道。难道配方里少了茴香这一味药材？",
              "character3": "王小二眼神闪烁，明显知道些什么。而且他频繁看向灶房的方向，那里绝对有秘密。"
            }
          },
          {
            "round": 3,
            "plot": "王小二趁李婶不注意，偷偷溜进了灶房。李婶察觉到王小二的举动，也悄悄跟了上去。此时，张掌柜突然折返回来，手里拿着一包东西，也走向了灶房。三人同时出现在灶房里，气氛变得紧张起来。",
            "privateClues": {
              "character1": "果然，灶台下面有个暗格！里面藏着一个瓷瓶，上面写着“秘制酱料”四个字。但瓷瓶是空的！难道有人捷足先登了？",
              "character2": "我看到张掌柜手里拿着一包茴香！他想干什么？难道他想自己调制配方？",
              "character3": "机会来了！王小二找到了瓷瓶，但他好像很失望。现在正是拿到配方的最好时机！"
            }
          }
        ],
        "personalScripts": {
          "character1": {
            "characterId": "character1",
            "personalBackground": "我，王小二，是老王那个没出息的儿子。说实话，老头子死得突然，我也没啥感觉。反正包子铺早晚是我的，只是没想到来得这么快。街坊邻居都说老头子手艺好，包子好吃，屁！要不是我从小给他烧火，他能做出这么好吃的包子？现在好了，老头子一死，配方就成了香饽饽。李婶那个老虔婆，天天装好人，肯定也惦记着。还有那个张掌柜，笑里藏刀，指不定背后憋着什么坏水。哼，想抢我的包子铺？没门儿！我得赶紧把配方找到，然后把包子铺盘出去，好好享受几年！",
            "personalRoundContents": [
              {
                "round": 1,
                "personalPlot": "头七祭拜？嘁，还不是走个过场。我颤颤巍巍地摆上供桌，心里想的却是老头子的钱匣子在哪。李婶那老东西，哭得比死了亲娘还伤心，真是装模作样。张掌柜那个老狐狸，眼睛滴溜溜地转，肯定在找东西。老头子说配方藏在最显眼的地方，可我找了半天，也没个影子。不行，得想个办法把他们支开。",
                "hiddenInfo": "老王临死前跟我说，配方就藏在“最显眼，但最容易被忽略的地方”。我知道老头子一向抠门，不可能藏在什么保险的地方，肯定就在这包子铺里。"
              },
              {
                "round": 2,
                "personalPlot": "吃包子？吃个屁！我只想赶紧找到配方。张掌柜装模作样地走了，肯定是回去琢磨怎么偷配方了。李婶那老太婆，一边吃还一边问配方的事儿，真是不要脸。我随便敷衍了几句，得找个机会溜进灶房看看。老头子说过，灶房里藏着大秘密，也许配方就在那里！",
                "hiddenInfo": "我记得小时候，老头子经常一个人在灶房里捣鼓什么，还神秘兮兮的不让我靠近。灶房肯定有问题！"
              },
              {
                "round": 3,
                "personalPlot": "趁李婶不注意，我偷偷溜进了灶房，开始翻箱倒柜地找。还没找到配方，就听到李婶的脚步声。糟糕，被她发现了！更糟糕的是，张掌柜竟然也回来了，手里还拿着一包东西，不知道是什么。这下可热闹了，三个人挤在灶房里，空气都凝固了。看来今天必须得拼一把了！",
                "hiddenInfo": "张掌柜手里拿的东西很可疑，看起来像是某种粉末。难道他是想毁掉包子铺？不行，我得阻止他！"
              }
            ]
          },
          "character2": {
            "characterId": "character2",
            "personalBackground": "你是这个故事中的关键人物，有着不为人知的秘密。",
            "personalRoundContents": [
              {
                "round": 1,
                "personalPlot": "你发现了尸体，心中充满了恐惧和疑虑。",
                "hiddenInfo": "你知道一些其他人不知道的秘密..."
              }
            ]
          },
          "character3": {
            "characterId": "character3",
            "personalBackground": "你是这个故事中的关键人物，有着不为人知的秘密。",
            "personalRoundContents": [
              {
                "round": 1,
                "personalPlot": "你发现了尸体，心中充满了恐惧和疑虑。",
                "hiddenInfo": "你知道一些其他人不知道的秘密..."
              }
            ]
          }
        },
        "plotRequirement": "吃包子",
        "collectedAt": 1754295505022,
        "collectedBy": "user_xiaoming"
      },
      {
        "id": "collected_1754295799687_zv879hbz1",
        "originalScriptId": "script_1754295711401_rk89l6e17",
        "originalGameId": "game_1754295730546_2rm1gik28",
        "title": "深夜包子铺",
        "rounds": 3,
        "background": "夜深了，雾气弥漫着整个巷子。你，李师傅，是这条老街上唯一一家还在营业的“老李包子铺”的老板。你的包子皮薄馅大，远近闻名。然而，最近总感觉周围弥漫着一股诡异的气氛。今天尤其奇怪，先是老顾客张婶突然要了十个肉包，说是要给去世的老伴送去，这大半夜的送包子？接着，平时从不吃肉包的王老头，竟然破天荒地要了两个猪肉大葱馅的。难道……这包子有什么秘密？更让你不安的是，你总觉得有人在暗中盯着你，盯着你的包子……",
        "characters": [
          {
            "id": "character1",
            "name": "李老实",
            "identity": "老李包子铺老板",
            "personality": "老实本分，手艺精湛，内心有些疑虑",
            "isMainCharacter": true
          },
          {
            "id": "character2",
            "name": "张翠花（张婶）",
            "identity": "老李包子铺的老顾客",
            "personality": "热心肠，有些唠叨，最近行为有些奇怪",
            "isMainCharacter": false
          },
          {
            "id": "character3",
            "name": "王福贵（王老头）",
            "identity": "老李包子铺的常客",
            "personality": "孤僻，沉默寡言，平时只吃素包",
            "isMainCharacter": false
          }
        ],
        "roundContents": [
          {
            "round": 1,
            "plot": "深夜，张婶匆匆忙忙地来到包子铺，买了十个肉包，神色慌张。王老头随后也来了，指名要两个猪肉大葱馅的包子，却只拿了两个馒头就走了，说自己年纪大了，记性不好。",
            "privateClues": {
              "character1": "张婶给的钱是新印的冥币，上面还有烧过的痕迹。王老头走后，你发现他落在桌子上了一张折叠的纸条，上面写着“今夜子时，后巷见”。",
              "character2": "你听说李老实最近研发了一种新的包子馅料，说是吃了能延年益寿。为了去世的老伴，你想试试看。李老实好像发现了什么。",
              "character3": "我本不该吃肉包，但为了接近李老实，不得不这么做。纸条上的内容，必须在今晚传递给他。"
            }
          },
          {
            "round": 2,
            "plot": "你决定跟踪王老头，发现他并没有回家，而是躲在后巷的阴影里。张婶似乎也鬼鬼祟祟地在附近徘徊，时不时地看向你的包子铺。巷子深处传来一阵低沉的哭声。",
            "privateClues": {
              "character1": "王老头似乎在等人，他手里紧紧攥着一个药瓶，上面依稀能辨认出“延年益寿”的字样。张婶似乎在躲着什么人，她总是回头看，眼神充满恐惧。",
              "character2": "我必须阻止王老头！他要毁了李老实！我看到他拿着的药瓶，那是禁药，吃了会让人丧失心智！",
              "character3": "时间不多了，我必须把真相告诉李老实。张翠花在监视我，她知道了我的计划。"
            }
          },
          {
            "round": 3,
            "plot": "子时已到，后巷里突然出现一个黑影。王老头颤颤巍巍地递给黑影一个包子。黑影一口吞下包子，发出诡异的笑声。张婶突然冲了出来，大喊着：“不要吃！”",
            "privateClues": {
              "character1": "黑影的身份不明，但他的手背上有一个奇怪的纹身，像是一个扭曲的包子。张婶冲向黑影，却被黑影一脚踢开，昏倒在地。",
              "character2": "那个黑影…是老陈！他吃了李老实的包子！完了，一切都完了！",
              "character3": "我的任务失败了…那个包子，被老陈吃掉了。李老实，快跑！"
            }
          }
        ],
        "personalScripts": {
          "character1": {
            "characterId": "character1",
            "personalBackground": "我叫李老实，在这条老街开了二十多年的包子铺了，街坊邻居都叫我老李。我的包子那可是出了名的，皮薄馅大，料足味美。可最近，总觉得不太对劲。先是这雾气，越来越浓，越来越阴冷。然后就是街坊们的举动，变得古怪起来。张婶突然大半夜要十个肉包，说是给过世的老伴送去，我这心里直犯嘀咕，哪有大半夜送包子的？还有王老头，一辈子不吃肉包，今天竟然主动要猪肉大葱馅的，转身却拿走了两个馒头！难不成…我这包子，真有什么问题？我总觉得有人在暗中窥视着我的包子铺，这种感觉让我寝食难安，我得弄清楚，到底发生了什么！",
            "personalRoundContents": [
              {
                "round": 1,
                "personalPlot": "夜深了，雾气真大，都快看不清对面的铺子了。张婶匆匆忙忙地跑来，脸色苍白，买了十个肉包，说是要给老伴送去。送包子？这都过了头七多少天了！不对劲！王老头也来了，平时只吃素的，今天竟然要猪肉大葱馅的，还只拿走了两个馒头。他眼神闪烁，好像在掩饰着什么。我这心里越来越不安，难道是包子馅有问题？我得仔细检查一下明天要用的肉！",
                "hiddenInfo": "我祖传的包子秘方里有一味特殊的香料，可以让人吃了之后精神百倍，但如果死人吃了，似乎会…会诈尸！难道他们发现了？"
              },
              {
                "round": 2,
                "personalPlot": "不行，我得看看王老头搞什么鬼！我偷偷跟在他后面，他竟然没回家，而是躲在后巷的阴影里！这老家伙，这么大年纪了，身子骨还挺硬朗。张婶也在附近徘徊，眼睛一直盯着我的包子铺。后巷里传来一阵低沉的哭声，听得我心里直发毛。这到底是怎么回事？他们为什么都盯着我的包子？",
                "hiddenInfo": "我偷偷在包子馅里加了安神的中药，希望能让大家睡个好觉，减轻一些雾气带来的压抑感。难道是这药出了问题？"
              },
              {
                "round": 3,
                "personalPlot": "子时了！后巷里突然出现一个黑影，看不清脸。王老头颤颤巍巍地走过去，递给黑影一个包子。黑影一口吞下包子，发出诡异的笑声，那笑声仿佛来自地狱！张婶突然冲了出来，大喊着：“不要吃！”她好像知道些什么！这黑影…这包子…到底有什么秘密？！我必须阻止这一切！",
                "hiddenInfo": "我发现包子里的肉馅，今天少了一味重要的药材——镇魂砂！这是祖上传下来的规矩，没有镇魂砂，包子会吸引一些不干净的东西！难道是有人故意拿走了镇魂砂？是谁？为什么？"
              }
            ]
          },
          "character2": {
            "characterId": "character2",
            "personalBackground": "唉，老李的包子是好吃，可最近这老街的气氛实在古怪。自从老伴走了之后，我这心里就空落落的。昨晚又梦见他了，他说想吃老李家的肉包子。大半夜的，我也知道不合适，可不给老伴送去，心里实在过意不去。街坊邻居都说我疯了，大半夜给死人送包子，可他们哪里知道我的苦？这老街啊，藏着太多秘密，我感觉老李的包子也变得不对劲了。为了老伴，也为了弄清楚这老街的秘密，我必须得做点什么。",
            "personalRoundContents": [
              {
                "round": 1,
                "personalPlot": "唉，还是买了十个肉包。老李看我的眼神怪怪的，肯定觉得我疯了。没办法，只能说给老伴送去，希望他能理解。王老头也来了？他平时不是只吃馒头吗？怎么突然要吃肉包了？看来他也有点不对劲。这老街...真是越来越让人不安了。",
                "hiddenInfo": "老伴去世前，一直念叨着老李家的肉包子，说里面有家的味道。"
              },
              {
                "round": 2,
                "personalPlot": "总觉得王老头有点不对劲，他拿了包子要去哪里？我悄悄跟着他，发现他竟然没回家，躲在后巷里。看来他也有秘密。老李的包子铺周围，果然弥漫着一股不祥的气息。不行，我得弄清楚王老头到底想干什么，他手里的包子又要给谁？",
                "hiddenInfo": "我曾经在后巷看到过一些奇怪的人影，他们似乎在寻找什么。"
              },
              {
                "round": 3,
                "personalPlot": "子时了，后巷里果然有动静！那个黑影...王老头竟然给他包子！不行，不能让他吃！我冲了出去，想要阻止，可...那黑影的气息让我感到恐惧。老李的包子...到底有什么问题？",
                "hiddenInfo": "老伴去世后，我经常能听到一些奇怪的声音，似乎来自后巷。"
              }
            ]
          },
          "character3": {
            "characterId": "character3",
            "personalBackground": "我，王福贵，这条街的老住户了。大家都叫我王老头，我也习惯了。老李的包子铺开了几十年，我也吃了他的包子几十年。年轻的时候，我喜欢吃他家的肉包，但自从那件事发生后，我就只吃素包了。最近老李的包子铺有点不对劲，空气里总弥漫着一股说不出的味道。尤其是今天，张翠花那个老婆子突然买那么多肉包，眼神闪烁不定，肯定有什么事瞒着大家。我原本不想多管闲事，只想安安静静过日子，但是……那股味道，让我不得不关注老李的包子了。我得弄清楚，这老李的包子，到底藏了什么秘密？当年……当年可不能重蹈覆辙了！",
            "personalRoundContents": [
              {
                "round": 1,
                "personalPlot": "张翠花匆匆忙忙地来了，买了十个肉包，看着她那慌张的样子，我心里更觉得不对劲。平时她都精打细算，怎么会突然买这么多？而且还是肉包，她老伴去世前最爱吃肉包了...莫非？我装作不经意地也要了两个猪肉大葱馅的，但临走时我悄悄换成了两个馒头，那肉包，我碰都不想碰，除非…确定它没有问题。",
                "hiddenInfo": "我知道张翠花的老伴是意外去世的，而且死前最喜欢吃老李家的肉包子。那股味道，我总感觉当年也闻到过。"
              },
              {
                "round": 2,
                "personalPlot": "我没回家，远远地躲在后巷的阴影里，看着张翠花在包子铺附近徘徊。她也在怀疑老李的包子吗？还是，她在等什么人？我感觉到一股阴冷的气息从巷子深处传来，像是一只无形的手，紧紧扼住我的喉咙。不能再等了，我必须弄清楚事情的真相。今晚，我一定要找到答案。",
                "hiddenInfo": "我知道后巷是通往城外乱葬岗的必经之路，那里埋葬着许多无名尸体。那股阴冷的气息，很可能和那里有关。"
              },
              {
                "round": 3,
                "personalPlot": "子时到了，后巷里出现了一个黑影，那黑影散发着腐朽的味道，让人作呕。我看到自己换掉的那个肉包被递给了黑影，黑影一口吞下，发出让人毛骨悚然的笑声。张翠花突然冲了出来，阻止黑影继续吃包子，嘶吼着：“不要吃！”…这……一切都和我当年想的一样！",
                "hiddenInfo": "我年轻时曾经目睹过类似的事情，一个穷困潦倒的人吃了老李家特制的“肉包”，之后就像变了一个人一样，最终惨死。老李的包子…根本不是普通的包子！"
              }
            ]
          }
        },
        "plotRequirement": "吃包子\n",
        "collectedAt": 1754295799687,
        "collectedBy": "user_xiaoming"
      },
      {
        "id": "collected_1754296253867_syizhpcx2",
        "originalScriptId": "script_1754296184455_m7z394qrt",
        "originalGameId": "game_1754296203277_qsd4bpo1g",
        "title": "妙脆角之谜",
        "rounds": 3,
        "background": "宁静的小镇克莱维尔，以其独特的妙脆角工厂而闻名。这座工厂是镇上的经济支柱，但最近却笼罩在一片阴影之中。工厂生产的妙脆角口味日渐衰退，甚至出现了奇怪的变味。人们怀疑工厂内部出现了问题，有人暗中破坏，试图毁掉这家工厂。艾米丽·卡特，妙脆角工厂的品控主管，必须在一切无法挽回之前，找出真相，拯救小镇的未来。",
        "characters": [
          {
            "id": "emilyCarter",
            "name": "艾米丽·卡特",
            "identity": "妙脆角工厂品控主管",
            "personality": "认真负责，追求完美，富有正义感",
            "isMainCharacter": true
          },
          {
            "id": "georgeMiller",
            "name": "乔治·米勒",
            "identity": "妙脆角工厂老员工，生产线负责人",
            "personality": "沉默寡言，经验丰富，有些神秘",
            "isMainCharacter": false
          },
          {
            "id": "lindaBrown",
            "name": "琳达·布朗",
            "identity": "妙脆角工厂新来的实习生",
            "personality": "活泼开朗，好奇心强，喜欢八卦",
            "isMainCharacter": false
          }
        ],
        "roundContents": [
          {
            "round": 1,
            "plot": "艾米丽发现最近一批妙脆角使用了过期香料，导致口感变差。乔治负责的生产线是主要嫌疑对象。琳达告诉艾米丽，她看到乔治晚上偷偷进入仓库，形迹可疑。",
            "privateClues": {
              "emilyCarter": "品控记录显示，过期香料的批号是20231026，供应商是远方的“老乔香料公司”。最近乔治经常请假，说是家里有事。",
              "georgeMiller": "我的妻子最近生病了，需要很多钱。我不得不偷偷接一些私活，晚上去仓库是帮人搬货，绝对和妙脆角没关系。我也不知道香料的事情。",
              "lindaBrown": "乔治那天晚上穿了一件很奇怪的黑色外套，似乎很怕被人认出来。他还带了一个很大的黑色袋子，不知道里面装了什么。之后我闻到了一股很浓的焦糖味。"
            }
          },
          {
            "round": 2,
            "plot": "艾米丽调查“老乔香料公司”，发现该公司已经倒闭三年了。她向乔治询问过期香料的事情，乔治闪烁其词，拒绝回答。琳达声称她找到了乔治丢弃的黑色外套，里面有一些妙脆角碎屑，味道很奇怪。",
            "privateClues": {
              "emilyCarter": "“老乔香料公司”的最后一位负责人叫乔纳森·米勒，和乔治·米勒只有一字之差。黑色外套上的妙脆角碎屑经过化验，发现里面含有少量氰化物。",
              "georgeMiller": "乔纳森·米勒是我的堂兄，他以前确实经营香料公司，但已经去世很久了。外套不是我的，我从来没穿过那种款式。有人想陷害我！",
              "lindaBrown": "我在工厂的监控录像中发现，有一个人影偷偷潜入了香料仓库，但因为光线太暗，看不清是谁。这个人影的身形和乔治很像，但走路的姿势有些不同。"
            }
          },
          {
            "round": 3,
            "plot": "艾米丽发现工厂的通风系统被人动过手脚，氰化物很可能是通过通风系统混入妙脆角中的。琳达承认她是受人指使，故意陷害乔治。幕后黑手竟然是…（真相需要根据玩家推理来填充，这里假设幕后黑手是妙脆角工厂的老板，他想通过这种方式让工厂倒闭，然后低价收购其他工厂）",
            "privateClues": {
              "emilyCarter": "工厂老板最近一直在和竞争对手秘密接触，似乎在商议收购的事情。老板还给琳达升职加薪，鼓励她多“学习经验”。",
              "georgeMiller": "老板经常对我说一些阴阳怪气的话，似乎对我的工作很不满意。他总是暗示我应该早点退休，把位置让给年轻人。",
              "lindaBrown": "老板答应我，只要我能把乔治赶走，就让我当生产线的主管。我承认我一时糊涂，做了错事，但我现在很后悔。"
            }
          }
        ],
        "personalScripts": {
          "emilyCarter": {
            "characterId": "emilyCarter",
            "personalBackground": "克莱维尔，一个因妙脆角而生的小镇，也曾是我的骄傲。自从我艾米丽·卡特担任妙脆角工厂的品控主管以来，就一直坚守着卡特家族对品质的承诺。但是，最近工厂生产的妙脆角口味越来越差，这让我寝食难安。更可怕的是，一些妙脆角甚至出现了奇怪的变味，这已经威胁到了消费者的健康安全！我必须查出真相，揪出那个暗中破坏的人，否则，不仅是妙脆角工厂，整个克莱维尔都会因此而衰落。我绝不能让这种事情发生。还有，老爸当年力排众议提拔我，我一定要证明给他看，我能守住卡特家族的荣耀，哪怕…哪怕真相会让我难以接受。",
            "personalRoundContents": [
              {
                "round": 1,
                "personalPlot": "今天例行抽检，结果让我大吃一惊！一批妙脆角竟然使用了过期香料！这种低级错误绝对不应该发生。我立刻追查源头，发现问题出在乔治负责的生产线。我找到乔治询问，他显得有些慌张，说是供应商送来的。可是，供应商一向可靠，而且香料的保质期有严格记录。实习生琳达偷偷告诉我，她昨晚看到乔治鬼鬼祟祟地进入仓库，这让我更加怀疑乔治。",
                "hiddenInfo": "卡特家族是妙脆角工厂的创始人，我的父亲是现任的CEO，但他最近身体不太好，公司的大小事务基本由股东们决定，这让我有些担心。"
              },
              {
                "round": 2,
                "personalPlot": "我调查了那批过期香料的供应商——“老乔香料公司”，结果发现这家公司竟然早在三年前就已经倒闭了！这绝对不是巧合。我再次找到乔治质问，但他始终闪烁其词，不肯正面回答。琳达又告诉我一个消息，她说她找到了乔治丢弃的黑色外套，里面有一些妙脆角碎屑，她觉得那些碎屑的味道很奇怪。难道乔治真的有问题？可他已经在工厂工作了几十年，我实在难以相信他会做出这种事情。",
                "hiddenInfo": "最近股东们一直在讨论将妙脆角工厂出售给其他公司，我强烈反对，但我的父亲却似乎有些动摇了。"
              },
              {
                "round": 3,
                "personalPlot": "我突发奇想，检查了工厂的通风系统，结果让我震惊！有人竟然动过手脚，在通风口附近发现了微量的氰化物残留！这意味着有人试图通过通风系统将氰化物混入妙脆角中！这已经不是简单的破坏，而是蓄意谋杀！正当我一筹莫展的时候，琳达突然承认她是受人指使，故意陷害乔治。她说她只知道那个人很有钱，答应给她一大笔钱。但幕后黑手到底是谁？",
                "hiddenInfo": "上次股东会议上，我听到有人提到如果工厂倒闭，他们就可以低价收购其他食品工厂。难道… 这一切都是他们计划好的？！"
              }
            ]
          },
          "georgeMiller": {
            "characterId": "georgeMiller",
            "personalBackground": "我在妙脆角工厂干了快三十年了，看着它从小作坊变成现在这样，心里头那份感情，比对我自己儿子还深。最近厂里的妙脆角味道越来越不对劲，我心里着急啊。过期香料？哼，老乔香料公司早就倒闭了！这事儿肯定不简单。新来的琳达总是盯着我，艾米丽也开始怀疑我。他们懂什么？我乔治·米勒是绝对不会做出毁掉妙脆角的事情的。我一定要查清楚，是谁在背后搞鬼，要毁了我的第二个家！只是…当年那件事，绝对不能被翻出来…如果他们查下去，恐怕...",
            "personalRoundContents": [
              {
                "round": 1,
                "personalPlot": "那批香料的问题我早发现了，想跟艾米丽说，但她好像对我有什么意见。琳达那个丫头片子，整天鬼鬼祟祟的。晚上去仓库，是为了检查机器，这有什么问题？厂子是我的命根子，我会眼睁睁看着它出事吗？哼，她看到我形迹可疑？真是胡说八道！",
                "hiddenInfo": "知道老乔香料公司在三年前已经倒闭。当年工厂差点倒闭，是老乔香料公司的人帮忙渡过难关。和老乔香料公司老板是老朋友。"
              },
              {
                "round": 2,
                "personalPlot": "艾米丽居然去查老乔香料公司了？她到底想干什么？我当然不能告诉她过期香料的事，说了又能怎么样？还不是徒增烦恼。那个琳达，肯定在背后说了我什么坏话。黑色外套？那是我的！但妙脆角碎屑？不可能！我绝对不会把脏东西带进生产线的。",
                "hiddenInfo": "外套上的妙脆角碎屑，其实是自己年轻时候，有一次生产事故不小心沾上的，当时为了不影响生产，没来得及清理干净。虽然外套洗过很多次，但味道还是很难完全去除。"
              },
              {
                "round": 3,
                "personalPlot": "通风系统？氰化物？这...这简直是疯了！琳达是被指使的？是谁？为什么要这么做？难道是…是老板？他想毁掉工厂？不可能！绝对不可能！看来我得尽快把当年的事情告诉艾米丽了，或许能帮她找到真正的凶手。",
                "hiddenInfo": "当年工厂差点倒闭，老板曾经向老乔香料公司借了一大笔钱，并且签下了一个秘密协议。协议内容是，如果妙脆角工厂的经营出现问题，老乔香料公司有权低价收购。老乔香料公司倒闭后，这份协议的继承者很有可能就是现在的妙脆角工厂老板。"
              }
            ]
          },
          "lindaBrown": {
            "characterId": "lindaBrown",
            "personalBackground": "克莱维尔小镇的妙脆角工厂，简直是我的梦想之地！我，琳达·布朗，终于成为这里的一名实习生啦！虽然只是个小小的实习生，但我对妙脆角的热爱可是货真价实的！听说最近工厂的妙脆角味道不太对劲，搞得人心惶惶的。大家都在猜测是不是有人搞破坏。我暗暗下定决心，一定要找到真相，让美味的妙脆角重回巅峰！而且…我偷偷喜欢乔治叔叔很久了，他那么认真负责，我希望他没事。但最近他总是愁眉苦脸的，还经常躲着人，这让我有点担心…我得好好观察一下，看看能不能帮到他！",
            "personalRoundContents": [
              {
                "round": 1,
                "personalPlot": "第一天上班，艾米丽主管就愁眉苦脸的，说是最近一批妙脆角用了过期香料，味道大不如前。我听到大家都在议论纷纷，猜测是不是生产线出了问题。晚上下班的时候，我看到乔治叔叔鬼鬼祟祟地进了仓库，他平时可不会去那里。我有点担心他，所以忍不住告诉了艾米丽主管这件事。",
                "hiddenInfo": "我撒了个小谎，其实我看到乔治叔叔进去的时间比大家下班早一个小时，当时我还以为他只是去拿东西。"
              },
              {
                "round": 2,
                "personalPlot": "艾米丽主管一直在调查过期香料的事情，好像查到了“老乔香料公司”，还问了乔治叔叔。乔治叔叔的脸色不太好，支支吾吾的，感觉有什么瞒着大家。今天我在垃圾桶旁边捡到一件黑色的外套，感觉是乔治叔叔的，上面还有一些妙脆角碎屑，味道闻起来怪怪的，说不出来。我犹豫了一下，还是决定把外套交给艾米丽主管。",
                "hiddenInfo": "外套上的碎屑味道确实有点不同，好像…有股淡淡的杏仁味？这跟我们平时吃的妙脆角可不一样。"
              },
              {
                "round": 3,
                "personalPlot": "艾米丽主管说工厂的通风系统被人动了手脚，还在妙脆角里发现了氰化物！我…我承认，是我诬陷了乔治叔叔。有人给了我一笔钱，让我按照他们说的去做，说这样可以帮到乔治叔叔。我…我真的被骗了！我不知道事情会变成这样，如果我知道会害到乔治叔叔，我绝对不会做的！",
                "hiddenInfo": "那个人给了我一张纸条，上面写着“让乔治背锅，事成之后再告诉你真相”。我没见过那个人，他戴着帽子和口罩，声音很沙哑，听不出来是谁。"
              }
            ]
          }
        },
