[
  {
    "id": "script_1754293443012_m4qi4jnv5",
    "title": "星河倒影：永恒的伽马爱恋",
    "rounds": 3,
    "background": "2347年，星际航行已成为常态。然而，一项秘密实验却在伽马星系悄然进行——时间旅行。伊丽丝·卡特博士，一位杰出的物理学家，致力于寻找连接过去与未来的桥梁，希望能够弥补百年前的历史遗憾。她的爱人，星际探险家亚历山大·雷诺兹，在一次意外的时空跃迁中失踪。伊丽丝坚信他依然活着，并毅然决然地启动了禁忌的时间机器“克洛诺斯”。然而，时空乱流远比她想象的危险，当她最终抵达的，却并非她所期望的亚历山大所在的时代，而是另一个充满谜团的时代……",
    "characters": [
      {
        "id": "elise_carter",
        "name": "伊丽丝·卡特",
        "identity": "2347年物理学家",
        "personality": "坚定、执着、聪慧、情感细腻",
        "isMainCharacter": true
      },
      {
        "id": "alexander_reynolds",
        "name": "亚历山大·雷诺兹",
        "identity": "2347年星际探险家",
        "personality": "勇敢、冒险、乐观、深爱伊丽丝",
        "isMainCharacter": true
      },
      {
        "id": "professor_meier",
        "name": "迈尔教授",
        "identity": "克洛诺斯项目主管 (AI NPC)",
        "personality": "严谨、理性、保守、对时间旅行持怀疑态度",
        "isMainCharacter": false
      },
      {
        "id": "temporal_guardian_ara",
        "name": "阿拉 (时间守护者)",
        "identity": "未知时代的神秘存在 (AI NPC)",
        "personality": "冷静、神秘、强大、守护时间秩序",
        "isMainCharacter": false
      }
    ],
    "roundContents": [
      {
        "round": 1,
        "plot": "伊丽丝抵达1923年的上海。她发现自己身处一个充满异域风情的码头。一名神秘男子在她耳边低语：“寻找伽马星的倒影，它会指引你。”她发现自己的时间机器损毁严重，无法立刻启动。亚历山大的消息全无，只剩下一张模糊的照片。",
        "privateClues": {
          "elise_carter": "你手里的照片背面写着“永恒咖啡馆”。咖啡馆的老板娘似乎知道一些关于时空穿越的秘密。你发现自己携带的能量核心只剩下30%的能量。",
          "alexander_reynolds": "你发现自己被困在一个陌生的时代。你身受重伤，唯一的线索是一枚刻着“伊丽丝”的怀表。有人正在追杀你，他们称你为“时间悖论”。"
        }
      },
      {
        "round": 2,
        "plot": "伊丽丝找到了永恒咖啡馆，老板娘是一位名叫宋美的优雅女子。宋美告诉她，亚历山大也曾来过这里，并留下了一封信。信中提及“伽马星的倒影”实际上是指上海天文台的一个特殊观测点。同时，时间守护者阿拉警告伊丽丝，她的行为正在扰乱时间线。",
        "privateClues": {
          "elise_carter": "宋美给你看了一张亚历山大留下的星图，星图上标记着一个特殊的坐标点。你怀疑那个坐标点是亚历山大最后一次跃迁的地点。 你发现咖啡馆地下室有一个简陋的时间研究实验室。",
          "alexander_reynolds": "你找到了一位神秘的医生，他为你疗伤，并告诉你追杀你的人来自一个名为“时间管理局”的组织，他们的目的是维护时间线的稳定。医生给了你一个地址，说是安全屋。"
        }
      },
      {
        "round": 3,
        "plot": "伊丽丝前往上海天文台。在观测点，她发现了一个隐秘的能量通道，可以短暂地与未来连接。与此同时，亚历山大也抵达了天文台，与伊丽丝重逢。然而，时间管理局的特工也追踪而来，并试图阻止他们。时间守护者阿拉决定介入，她给出了最终的选择：修复时间线，或者一同前往未知的未来。",
        "privateClues": {
          "elise_carter": "能量通道需要大量的能量才能启动。你必须做出选择：是使用剩余的能量回到未来，还是利用它去寻找亚历山大坠落的时空点。 亚历山大告诉你，时间管理局的目的是抹杀所有时间旅行的可能性。",
          "alexander_reynolds": "你发现时间管理局的特工中有一个人非常像过去的迈尔教授。他告诉你伊丽丝的行为已经严重威胁到整个宇宙的时间稳定，你必须阻止她。 阿拉的出现让你意识到，时间并非线性，而是无数个可能性的交织。"
        }
      }
    ],
    "createdAt": 1754293443012,
    "createdBy": "system"
  },
  {
    "id": "script_1754293469256_51edbkfad",
    "title": "轮回之樱",
    "rounds": 3,
    "background": "公元2249年，东京，科技高度发达。绫，一位顶尖的程序员，偶然间发现了一个隐藏在古老服务器中的时间旅行程序“樱”。抱着对祖父辈爱情故事的好奇，绫启动了程序，却意外将自己和她的青梅竹马，同时也是历史学教授的健太，一起传送回了1944年的京都。战火纷飞，两人必须在历史的洪流中生存，寻找回到未来的方法，并解开“樱”程序背后隐藏的秘密。更重要的是，他们必须确保自己的存在不会改变历史，而这段穿越时空的旅程，也将考验他们之间的情感。",
    "characters": [
      {
        "id": "ayane",
        "name": "绫（Ayane）",
        "identity": "2249年程序员",
        "personality": "聪明，独立，好奇心强，略带冒险精神",
        "isMainCharacter": true
      },
      {
        "id": "kenta",
        "name": "健太（Kenta）",
        "identity": "2249年历史学教授",
        "personality": "沉稳，博学，责任感强，略微保守",
        "isMainCharacter": true
      },
      {
        "id": "sakura",
        "name": "樱（Sakura）",
        "identity": "1944年艺伎",
        "personality": "温柔，体贴，善解人意，内心隐藏着秘密",
        "isMainCharacter": false
      },
      {
        "id": "hideki",
        "name": "秀吉（Hideki）",
        "identity": "1944年军官",
        "personality": "严肃，冷酷，忠于职守，对艺伎樱怀有特别的情感",
        "isMainCharacter": false
      }
    ],
    "roundContents": [
      {
        "round": 1,
        "plot": "绫和健太突然出现在1944年的京都街头，茫然不知所措。他们身穿未来服装，引人注目。樱，一位美丽的艺伎，注意到了他们，并主动上前提供帮助。秀吉，一位军官，也对他们产生了兴趣，但更多的是怀疑。",
        "privateClues": {
          "ayane": "你发现你的手腕上的时间手环显示异常，无法确定具体的传送坐标，但上面的电池图标闪烁，表示能量即将耗尽，必须尽快找到充电的方法。",
          "kenta": "你注意到樱身上佩戴的樱花发簪，与祖父照片上祖母的发簪几乎一模一样。你开始怀疑历史是否正在重演，或者这根本不是巧合。"
        }
      },
      {
        "round": 2,
        "plot": "樱将绫和健太带到她所居住的茶馆，暂时安顿下来。绫试图寻找能够给时间手环充电的设备，但1944年的科技水平远无法满足她的需求。秀吉开始调查绫和健太的身份，怀疑他们是间谍。",
        "privateClues": {
          "ayane": "你发现茶馆的地下室隐藏着一个秘密房间，里面有一些旧式的电子设备，似乎在进行某种秘密的研究。你隐约觉得这与“樱”程序有关。",
          "kenta": "你无意中听到樱和秀吉的对话，得知秀吉即将被调往战场，而樱似乎对他依依不舍。你回忆起祖母从未提及过这段感情，这与历史记载并不相符。"
        }
      },
      {
        "round": 3,
        "plot": "绫终于找到了一个能够给时间手环充电的线索，但需要使用茶馆地下室的设备。秀吉的调查逐渐深入，他开始怀疑樱与绫和健太之间存在某种关联。樱为了保护绫和健太，不得不做出艰难的抉择。",
        "privateClues": {
          "ayane": "你成功启动了地下室的设备，时间手环开始充电。然而，设备发出巨大的噪音，很可能会引起秀吉的注意。你必须尽快完成充电，否则将功亏一篑。",
          "kenta": "你发现樱在偷偷销毁一些信件，信件的内容似乎与时间旅行有关。你意识到樱或许知道关于“樱”程序的更多秘密，但她似乎并不想告诉你。"
        }
      }
    ],
    "createdAt": 1754293469256,
    "createdBy": "system"
  },
  {
    "id": "script_1754294815279_l158eh1ip",
    "title": "包子风云：老字号之争",
    "rounds": 3,
    "background": "百年老字号“德兴包子铺”名震一方，招牌鲜肉包更是远近闻名。老掌柜赵老爷子年事已高，决定举办一场别开生面的吃包子大赛，胜者将获得德兴包子铺的经营权。消息一出，各路包子爱好者蜂拥而至，然而，看似简单的比赛背后，却隐藏着一场关于家族恩怨和商业阴谋的较量。是单纯的比拼食量，还是暗流涌动的权力争夺？包子的香味中，弥漫着一丝不同寻常的味道……",
    "characters": [
      {
        "id": "character1",
        "name": "赵小曼",
        "identity": "赵老爷子的孙女，从小在包子铺长大",
        "personality": "精明能干，外柔内刚，对家族生意有强烈的责任感，但对爷爷的传统经营理念有所不满，想要革新。",
        "isMainCharacter": true
      },
      {
        "id": "character2",
        "name": "李大壮",
        "identity": "远近闻名的“大胃王”，梦想是吃遍天下美食",
        "personality": "憨厚老实，饭量惊人，性格开朗，看似无欲无求，但其实对包子有着超出常人的热爱和执着。",
        "isMainCharacter": true
      },
      {
        "id": "character3",
        "name": "王婶",
        "identity": "德兴包子铺的老员工，负责后厨",
        "personality": "沉默寡言，做事认真，对德兴包子铺忠心耿耿，但似乎知道一些不为人知的秘密。",
        "isMainCharacter": false
      },
      {
        "id": "character4",
        "name": "张老板",
        "identity": "邻街新开的“美味包子”铺老板，商业竞争者",
        "personality": "精明市侩，野心勃勃，一心想吞并德兴包子铺，为人不择手段。",
        "isMainCharacter": false
      }
    ],
    "roundContents": [
      {
        "round": 1,
        "plot": "比赛正式开始，选手们摩拳擦掌。第一轮是限时吃包子，规定时间内吃得最多者胜出。赵小曼凭借对包子制作的了解，制定了策略，而李大壮则凭借天生的饭量优势一路领先。王婶在一旁默默地看着，眼神复杂。张老板则在人群中四处打量，似乎在寻找着什么。",
        "privateClues": {
          "character1": "爷爷赵老爷子比赛前偷偷塞给你一张纸条，上面写着：“小心张老板，提防包子馅料。”看来爷爷对张老板有所防备。",
          "character2": "你无意中听到王婶在嘀咕：“老爷子这次太冲动了，这包子铺早晚要出事。”王婶似乎对比赛的举办并不赞同。"
        }
      },
      {
        "round": 2,
        "plot": "第二轮比赛是盲吃猜馅。选手们需要蒙上眼睛，通过品尝辨别包子馅料，答对最多者胜出。赵小曼凭借从小对馅料的熟悉，表现出色。李大壮虽然味觉灵敏，但在一些特殊馅料上犯了难。张老板开始在比赛过程中故意制造混乱，干扰选手判断。",
        "privateClues": {
          "character1": "你闻到今天的包子馅料中，有一股淡淡的药味，这味道和平时不太一样。是有人动了手脚吗？",
          "character2": "你发现张老板一直在偷偷观察赵小曼，他的眼神里充满了敌意和算计。他对赵小曼似乎另有所图。"
        }
      },
      {
        "round": 3,
        "plot": "最终轮比赛是包包子。选手需要现场制作包子，由评委品尝打分，综合前两轮成绩决定胜负。赵小曼展示了精湛的包包子技艺，但却发现面粉似乎被人动了手脚，影响了口感。李大壮虽然不太擅长包包子，但他用真诚和对包子的热爱打动了评委。王婶突然站出来，揭露了一个惊人的真相……",
        "privateClues": {
          "character1": "你发现包子铺的账本不见了，这本账本记录了德兴包子铺多年来的经营状况，以及一些重要的商业秘密。",
          "character2": "你发现王婶的手上有一个烫伤的痕迹，这痕迹和你昨天看到张老板手上的一模一样。他们之间有什么关系？"
        }
      }
    ],
    "createdAt": 1754294815279,
    "createdBy": "system"
  },
  {
    "id": "script_1754295413704_msov3ekhc",
    "title": "老王的包子铺",
    "rounds": 3,
    "background": "清末民初，北平城根儿下，老王开了家包子铺，远近闻名。他家的包子皮薄馅大，味道鲜美，尤其是秘制酱料，更是让人百吃不厌。然而，最近老王去世了，留下了一张神秘的配方。据说，谁能找到这张配方，就能继承老王的包子铺和他的手艺。街坊邻居都觊觎着这份配方，暗流涌动。今天是老王头七，按照习俗，要在包子铺里摆上供桌，烧纸祭拜。大家都想借着这个机会，看看有没有机会找到配方。",
    "characters": [
      {
        "id": "character1",
        "name": "王小二",
        "identity": "老王的儿子，好吃懒做",
        "personality": "贪财，胆小，游手好闲",
        "isMainCharacter": true
      },
      {
        "id": "character2",
        "name": "李婶",
        "identity": "老王的邻居，热心肠",
        "personality": "八卦，爱占便宜，心直口快"
      },
      {
        "id": "character3",
        "name": "张掌柜",
        "identity": "对面酒楼的掌柜，精明",
        "personality": "算计，圆滑，唯利是图"
      }
    ],
    "roundContents": [
      {
        "round": 1,
        "plot": "头七祭拜开始了，王小二颤颤巍巍地摆上供桌，李婶和张掌柜也在一旁帮忙。李婶一边烧纸，一边嘀咕着老王的好。张掌柜则四处张望，似乎在寻找什么。王小二显得心不在焉，眼睛时不时地瞟向钱匣子。",
        "privateClues": {
          "character1": "爹临走前，塞给我一个写着“灶”字的纸条，没头没尾的，不知道啥意思。",
          "character2": "我看到张掌柜偷偷摸摸地翻动着老王的遗物，鬼鬼祟祟的。他肯定有什么目的。",
          "character3": "老王去世前几天，曾跟我抱怨，说他儿子不争气，想把包子铺交给信任的人。难道配方在他儿子手里？"
        }
      },
      {
        "round": 2,
        "plot": "祭拜结束后，李婶提议大家一起吃包子，缅怀老王。王小二勉强同意。张掌柜借口要照顾酒楼生意，先行离开，但临走前，他状似无意地问了王小二关于包子铺未来的打算。李婶则一边吃着包子，一边夸赞老王的手艺，并旁敲侧击地询问配方的事情。",
        "privateClues": {
          "character1": "娘说过，家里的传家宝都藏在最意想不到的地方。灶台下面有什么东西吗？得找机会去看看。",
          "character2": "这包子的味道跟以前不一样了！少了点什么…对了，是少了点茴香的味道。难道配方里少了茴香这一味药材？",
          "character3": "王小二眼神闪烁，明显知道些什么。而且他频繁看向灶房的方向，那里绝对有秘密。"
        }
      },
      {
        "round": 3,
        "plot": "王小二趁李婶不注意，偷偷溜进了灶房。李婶察觉到王小二的举动，也悄悄跟了上去。此时，张掌柜突然折返回来，手里拿着一包东西，也走向了灶房。三人同时出现在灶房里，气氛变得紧张起来。",
        "privateClues": {
          "character1": "果然，灶台下面有个暗格！里面藏着一个瓷瓶，上面写着“秘制酱料”四个字。但瓷瓶是空的！难道有人捷足先登了？",
          "character2": "我看到张掌柜手里拿着一包茴香！他想干什么？难道他想自己调制配方？",
          "character3": "机会来了！王小二找到了瓷瓶，但他好像很失望。现在正是拿到配方的最好时机！"
        }
      }
    ],
    "createdAt": 1754295413704,
    "createdBy": "system"
  },
  {
    "id": "script_1754295711401_rk89l6e17",
    "title": "深夜包子铺",
    "rounds": 3,
    "background": "夜深了，雾气弥漫着整个巷子。你，李师傅，是这条老街上唯一一家还在营业的“老李包子铺”的老板。你的包子皮薄馅大，远近闻名。然而，最近总感觉周围弥漫着一股诡异的气氛。今天尤其奇怪，先是老顾客张婶突然要了十个肉包，说是要给去世的老伴送去，这大半夜的送包子？接着，平时从不吃肉包的王老头，竟然破天荒地要了两个猪肉大葱馅的。难道……这包子有什么秘密？更让你不安的是，你总觉得有人在暗中盯着你，盯着你的包子……",
    "characters": [
      {
        "id": "character1",
        "name": "李老实",
        "identity": "老李包子铺老板",
        "personality": "老实本分，手艺精湛，内心有些疑虑",
        "isMainCharacter": true
      },
      {
        "id": "character2",
        "name": "张翠花（张婶）",
        "identity": "老李包子铺的老顾客",
        "personality": "热心肠，有些唠叨，最近行为有些奇怪",
        "isMainCharacter": false
      },
      {
        "id": "character3",
        "name": "王福贵（王老头）",
        "identity": "老李包子铺的常客",
        "personality": "孤僻，沉默寡言，平时只吃素包",
        "isMainCharacter": false
      }
    ],
    "roundContents": [
      {
        "round": 1,
        "plot": "深夜，张婶匆匆忙忙地来到包子铺，买了十个肉包，神色慌张。王老头随后也来了，指名要两个猪肉大葱馅的包子，却只拿了两个馒头就走了，说自己年纪大了，记性不好。",
        "privateClues": {
          "character1": "张婶给的钱是新印的冥币，上面还有烧过的痕迹。王老头走后，你发现他落在桌子上了一张折叠的纸条，上面写着“今夜子时，后巷见”。",
          "character2": "你听说李老实最近研发了一种新的包子馅料，说是吃了能延年益寿。为了去世的老伴，你想试试看。李老实好像发现了什么。",
          "character3": "我本不该吃肉包，但为了接近李老实，不得不这么做。纸条上的内容，必须在今晚传递给他。"
        }
      },
      {
        "round": 2,
        "plot": "你决定跟踪王老头，发现他并没有回家，而是躲在后巷的阴影里。张婶似乎也鬼鬼祟祟地在附近徘徊，时不时地看向你的包子铺。巷子深处传来一阵低沉的哭声。",
        "privateClues": {
          "character1": "王老头似乎在等人，他手里紧紧攥着一个药瓶，上面依稀能辨认出“延年益寿”的字样。张婶似乎在躲着什么人，她总是回头看，眼神充满恐惧。",
          "character2": "我必须阻止王老头！他要毁了李老实！我看到他拿着的药瓶，那是禁药，吃了会让人丧失心智！",
          "character3": "时间不多了，我必须把真相告诉李老实。张翠花在监视我，她知道了我的计划。"
        }
      },
      {
        "round": 3,
        "plot": "子时已到，后巷里突然出现一个黑影。王老头颤颤巍巍地递给黑影一个包子。黑影一口吞下包子，发出诡异的笑声。张婶突然冲了出来，大喊着：“不要吃！”",
        "privateClues": {
          "character1": "黑影的身份不明，但他的手背上有一个奇怪的纹身，像是一个扭曲的包子。张婶冲向黑影，却被黑影一脚踢开，昏倒在地。",
          "character2": "那个黑影…是老陈！他吃了李老实的包子！完了，一切都完了！",
          "character3": "我的任务失败了…那个包子，被老陈吃掉了。李老实，快跑！"
        }
      }
    ],
    "createdAt": 1754295711401,
    "createdBy": "system"
  },
  {
    "id": "script_1754296184455_m7z394qrt",
    "title": "妙脆角之谜",
    "rounds": 3,
    "background": "宁静的小镇克莱维尔，以其独特的妙脆角工厂而闻名。这座工厂是镇上的经济支柱，但最近却笼罩在一片阴影之中。工厂生产的妙脆角口味日渐衰退，甚至出现了奇怪的变味。人们怀疑工厂内部出现了问题，有人暗中破坏，试图毁掉这家工厂。艾米丽·卡特，妙脆角工厂的品控主管，必须在一切无法挽回之前，找出真相，拯救小镇的未来。",
    "characters": [
      {
        "id": "emilyCarter",
        "name": "艾米丽·卡特",
        "identity": "妙脆角工厂品控主管",
        "personality": "认真负责，追求完美，富有正义感",
        "isMainCharacter": true
      },
      {
        "id": "georgeMiller",
        "name": "乔治·米勒",
        "identity": "妙脆角工厂老员工，生产线负责人",
        "personality": "沉默寡言，经验丰富，有些神秘",
        "isMainCharacter": false
      },
      {
        "id": "lindaBrown",
        "name": "琳达·布朗",
        "identity": "妙脆角工厂新来的实习生",
        "personality": "活泼开朗，好奇心强，喜欢八卦",
        "isMainCharacter": false
      }
    ],
    "roundContents": [
      {
        "round": 1,
        "plot": "艾米丽发现最近一批妙脆角使用了过期香料，导致口感变差。乔治负责的生产线是主要嫌疑对象。琳达告诉艾米丽，她看到乔治晚上偷偷进入仓库，形迹可疑。",
        "privateClues": {
          "emilyCarter": "品控记录显示，过期香料的批号是20231026，供应商是远方的“老乔香料公司”。最近乔治经常请假，说是家里有事。",
          "georgeMiller": "我的妻子最近生病了，需要很多钱。我不得不偷偷接一些私活，晚上去仓库是帮人搬货，绝对和妙脆角没关系。我也不知道香料的事情。",
          "lindaBrown": "乔治那天晚上穿了一件很奇怪的黑色外套，似乎很怕被人认出来。他还带了一个很大的黑色袋子，不知道里面装了什么。之后我闻到了一股很浓的焦糖味。"
        }
      },
      {
        "round": 2,
        "plot": "艾米丽调查“老乔香料公司”，发现该公司已经倒闭三年了。她向乔治询问过期香料的事情，乔治闪烁其词，拒绝回答。琳达声称她找到了乔治丢弃的黑色外套，里面有一些妙脆角碎屑，味道很奇怪。",
        "privateClues": {
          "emilyCarter": "“老乔香料公司”的最后一位负责人叫乔纳森·米勒，和乔治·米勒只有一字之差。黑色外套上的妙脆角碎屑经过化验，发现里面含有少量氰化物。",
          "georgeMiller": "乔纳森·米勒是我的堂兄，他以前确实经营香料公司，但已经去世很久了。外套不是我的，我从来没穿过那种款式。有人想陷害我！",
          "lindaBrown": "我在工厂的监控录像中发现，有一个人影偷偷潜入了香料仓库，但因为光线太暗，看不清是谁。这个人影的身形和乔治很像，但走路的姿势有些不同。"
        }
      },
      {
        "round": 3,
        "plot": "艾米丽发现工厂的通风系统被人动过手脚，氰化物很可能是通过通风系统混入妙脆角中的。琳达承认她是受人指使，故意陷害乔治。幕后黑手竟然是…（真相需要根据玩家推理来填充，这里假设幕后黑手是妙脆角工厂的老板，他想通过这种方式让工厂倒闭，然后低价收购其他工厂）",
        "privateClues": {
          "emilyCarter": "工厂老板最近一直在和竞争对手秘密接触，似乎在商议收购的事情。老板还给琳达升职加薪，鼓励她多“学习经验”。",
          "georgeMiller": "老板经常对我说一些阴阳怪气的话，似乎对我的工作很不满意。他总是暗示我应该早点退休，把位置让给年轻人。",
          "lindaBrown": "老板答应我，只要我能把乔治赶走，就让我当生产线的主管。我承认我一时糊涂，做了错事，但我现在很后悔。"
        }
      }
    ],
    "createdAt": 1754296184455,
    "createdBy": "system"
  },
  {
    "id": "script_1754296546629_awuhxq8hd",
    "title": "薯条争霸赛：谁偷走了我的薯条？",
    "rounds": 3,
    "background": "一年一度的“薯条争霸赛”在快餐店“黄金脆”总部拉开帷幕。四位选手齐聚一堂，目标只有一个：在三轮比赛中吃下最多的薯条，赢得“薯条大胃王”的称号以及“黄金脆”终身免费薯条的奖励。然而，比赛开始前夕，选手之一的阿强却发现自己准备好的秘密武器——特制芥末酱，不翼而飞。这芥末酱可是他获胜的关键！怀疑的种子在选手之间蔓延，这场比赛不仅仅是关于薯条，更是一场关于信任和阴谋的较量。谁是幕后黑手？芥末酱又去了哪里？",
    "characters": [
      {
        "id": "阿强",
        "name": "李阿强",
        "identity": "资深薯条爱好者，往届比赛亚军",
        "personality": "耿直、好胜心强，略带神经质，对薯条有近乎痴迷的热爱",
        "isMainCharacter": true
      },
      {
        "id": "小美",
        "name": "王小美",
        "identity": "美食博主，新晋网红",
        "personality": "活泼开朗，善于交际，看似单纯，实则精明",
        "isMainCharacter": false
      },
      {
        "id": "老王",
        "name": "王老根",
        "identity": "退休老干部，自称“薯条养生专家”",
        "personality": "固执、保守，喜欢倚老卖老，对薯条的吃法有着独特见解",
        "isMainCharacter": false
      },
      {
        "id": "艾米",
        "name": "艾米丽",
        "identity": "留学生，好奇宝宝",
        "personality": "热情、好奇心强，喜欢尝试新鲜事物，对亚洲文化充满兴趣",
        "isMainCharacter": false
      }
    ],
    "roundContents": [
      {
        "round": 1,
        "plot": "比赛正式开始。主持人宣布规则：第一轮为“速度挑战”，选手需要在五分钟内吃下尽可能多的薯条。比赛过程中，阿强明显受到影响，速度大不如前，其他人表现正常。小美看似漫不经心，但实际吃下的薯条数量惊人。老王依然坚持他的“养生吃法”，细嚼慢咽。艾米则一直在尝试各种蘸料。",
        "privateClues": {
          "阿强": "你早上明明检查过芥末酱还在包里，现在却不见了。你怀疑是小美，因为她刚才一直在你旁边晃悠，还问你“你准备了什么秘密武器啊？”。",
          "小美": "你在比赛前看到老王偷偷往自己的薯条里撒了一种奇怪的白色粉末。你觉得这肯定是他获胜的秘诀，而且他特别不愿意别人靠近他的薯条。",
          "老王": "你看到艾米在不停地拍照，似乎在记录你们吃薯条的姿势。你觉得她可能在研究什么，这让你感到不舒服。",
          "艾米": "你发现阿强看起来心不在焉，一直盯着自己的包。似乎有什么东西对他很重要，而且他好像弄丢了。你还听到他在小声嘟囔着“芥末酱”。"
        }
      },
      {
        "round": 2,
        "plot": "第二轮是“创意吃法”。选手需要用提供的食材，搭配薯条，创造出独特的吃法。阿强依然闷闷不乐，随便搭配了一下。小美用番茄酱和芥末酱混合，创造出一种新口味，引得众人称赞。老王则用自带的枸杞泡水蘸薯条，引发争议。艾米将薯条蘸着冰淇淋吃，表示这才是正宗的“美式吃法”。",
        "privateClues": {
          "阿强": "你注意到小美用的芥末酱似乎和你丢失的包装非常相似，但你无法确定。你还看到老王一直在偷偷观察你，眼神里带着一丝幸灾乐祸。",
          "小美": "你从主持人那里得知，芥末酱是赞助商特别提供的，只有一份。你开始怀疑阿强可能根本没有带芥末酱，一切只是他自导自演的戏码，目的是扰乱你的心神。",
          "老王": "你发现艾米的冰淇淋融化了一些，滴在了地上。地上出现了一些奇怪的白色粉末，你认出那是某种泻药的成分。你开始怀疑有人想要陷害其他人。",
          "艾米": "你无意中看到老王偷偷地把一些白色粉末倒进了阿强的饮料里。你不知道那是什么，但你觉得事情变得越来越复杂了。"
        }
      },
      {
        "round": 3,
        "plot": "最终轮“耐力挑战”。选手需要在十分钟内，尽可能地保持吃薯条的速度，谁坚持到最后，谁就是赢家。阿强在吃了第一口薯条后，突然脸色苍白，捂着肚子跑了出去。小美、老王和艾米继续比赛，但气氛异常紧张。最后，小美凭借着稳定的发挥，赢得了比赛。然而，比赛结束后，阿强却声称自己是被陷害的。",
        "privateClues": {
          "阿强": "你喝了饮料后，肚子开始剧痛。你确信有人在你的饮料里下了药。你怀疑是老王，因为他一直对你的‘秘密武器’耿耿于怀。",
          "小美": "你赢得了比赛，但你总觉得哪里不对劲。你开始怀疑自己是不是被利用了，而真正的目标并不是冠军，而是其他的东西。",
          "老王": "你看到艾米在阿强离开后，偷偷地擦掉了地上的白色粉末。你开始怀疑艾米才是幕后黑手，她可能在利用这次比赛进行某种秘密交易。",
          "艾米": "你看到小美在比赛结束后，偷偷地把一些东西塞进了自己的包里。你觉得她一定知道些什么，而且她很有可能就是偷走阿强芥末酱的人。"
        }
      }
    ],
    "createdAt": 1754296546629,
    "createdBy": "system"
  },
  {
