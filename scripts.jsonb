  {
    "id": "script_1757052195936_m9ynnvaay",
    "title": "未知剧本",
    "rounds": 4,
    "background": "故事发生在一个未知的小镇上，一场突如其来的事件打破了这里的平静。镇上的居民们各自怀揣着秘密，而真相隐藏在重重迷雾之中。玩家将扮演不同的角色，通过搜集线索、推理和互动，逐步揭开事件的真相，并找出隐藏在幕后的黑手。",
    "characters": [
      {
        "id": "c1",
        "name": "安安",
        "identity": "平民",
        "personality": "善良，好奇；查明真相，保护自己",
        "isMainCharacter": true
      },
      {
        "id": "c2",
        "name": "李斯楠",
        "identity": "嫌疑人",
        "personality": "冷静，神秘；隐藏秘密，逃脱嫌疑",
        "isMainCharacter": true
      }
    ],
    "roundContents": [
      {
        "round": 1,
        "plot": "镇上发生了一起离奇的案件，死者身份不明。警局封锁了现场，展开调查。所有居民都被要求配合调查，提供线索。玩家们开始互相试探，寻找可疑之处。",
        "privateClues": {
          "c1": "发现了一些奇怪的痕迹。",
          "c2": "回忆起昨晚的可疑行动。"
        }
      }
    ],
    "finalResolution": "真相最终浮出水面，原来一切都是一场精心策划的阴谋。凶手被绳之以法，小镇恢复了往日的平静。但每个人心中都留下了难以磨灭的印记。",
    "mechanics": "",
    "recommendedPlayerCount": 6,
    "allowNPCFill": false,
