  {
    "id": "script_1757056364446_wf5hsv1eh",
    "title": "未知剧本",
    "rounds": 4,
    "background": "故事发生在一个架空的世界，原本平静祥和的小镇突然发生了一起离奇的案件。镇上德高望重的罗素先生神秘失踪，而年轻的安安似乎掌握着重要的线索。每个人都隐藏着不为人知的秘密，随着调查的深入，真相逐渐浮出水面，但同时也带来了更多的谜团。",
    "characters": [
      {
        "id": "c1",
        "name": "罗素",
        "identity": "关键人物",
        "personality": "德高望重，深藏不露；隐藏的秘密",
        "isMainCharacter": true
      },
      {
        "id": "c2",
        "name": "安安",
        "identity": "知情者",
        "personality": "年轻，神秘；守护秘密或揭露真相",
        "isMainCharacter": true
      }
    ],
    "roundContents": [
      {
        "round": 1,
        "plot": "罗素失踪的消息传开，镇上人心惶惶。警长开始调查，初步排查了罗素先生的住所和办公室，发现了一些可疑的痕迹，但并未找到罗素先生的下落。",
        "privateClues": {
          "c1": "",
          "c2": "我最后一次见到罗素先生是在三天前的傍晚。"
        }
      },
      {
        "round": 2,
        "plot": "调查范围扩大，警长开始询问镇上的居民，试图找到目击证人。安安的证词引起了警长的注意，但安安似乎有所隐瞒。",
        "privateClues": {
          "c1": "",
          "c2": "我不能说出全部的真相，否则会有人受到伤害。"
        }
      }
    ],
    "finalResolution": "最终，真相水落石出，原来罗素先生并非失踪，而是为了保护镇上的一个秘密而选择了离开。安安最终鼓起勇气，向大家揭露了真相，镇上恢复了平静。",
    "mechanics": "",
    "recommendedPlayerCount": 6,
    "allowNPCFill": false,
    "npcSuggestion": {
      "needNPC": false,
      "minHumanPlayers": 0,
      "maxNPC": 0,
      "reason": ""
    },
    "createdAt": 1757056364446,
    "createdBy": "import",
